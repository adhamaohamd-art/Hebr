rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isUserActive(userId) {
      return !exists(/databases/$(database)/documents/users/$(userId)) ||
        get(/databases/$(database)/documents/users/$(userId)).data.get('status', 'active') == 'active';
    }

    function hasNovelEntitlement(novelId) {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/entitlements/$(novelId));
    }

    function hasActiveSubscription() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscription != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscription.expiresAt > request.time.toMillis();
    }

    // A subscription unlocks a novel only if its plan includes it:
    //  - 'admin_grant' (manual grant by an admin; users cannot write 'subscription') unlocks all
    //  - otherwise plans/{planId} must have accessAll == true or list the novel in novelIds
    function subscriptionCoversNovel(novelId) {
      let sub = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscription;
      let planPath = /databases/$(database)/documents/plans/$(sub.planId);
      return sub.planId == 'admin_grant' ||
        (exists(planPath) &&
          (get(planPath).data.get('accessAll', false) == true ||
           novelId in get(planPath).data.get('novelIds', [])));
    }

    function hasActiveSubscriptionFor(novelId) {
      return hasActiveSubscription() && subscriptionCoversNovel(novelId);
    }

    // ---------------------------------------------------------------------------------------
    // Writers (كتّاب). A reader may own novels up to a quota:
    //   quota = larger of  users/{uid}.writerLimit            (granted by an admin)
    //           and        plans/{subscription.planId}.writerNovelLimit  (while the subscription is active)
    // The number of novels a writer owns lives in writerStats/{uid}.novelCount. It can only move by
    // exactly +1 / -1 in the SAME batch as the creation / deletion of a novel owned by that writer
    // (get = state before, getAfter = state after), so neither the counter nor the quota can be
    // forged from the browser. Same pattern as the rating aggregates below.
    //
    // Writers can NEVER: publish (published stays false until an admin approves), set prices,
    // free-chapter flags, ratings, or touch catalog/home. Admin approval makes the novel public.
    // ---------------------------------------------------------------------------------------

    // Quota coming from the plan of an ACTIVE subscription ('admin_grant' carries no writer quota).
    function planWriterLimit(u) {
      return (u.get('subscription', null) != null &&
              u.subscription.expiresAt > request.time.toMillis() &&
              u.subscription.planId != 'admin_grant' &&
              exists(/databases/$(database)/documents/plans/$(u.subscription.planId)))
        ? get(/databases/$(database)/documents/plans/$(u.subscription.planId)).data.get('writerNovelLimit', 0)
        : 0;
    }

    function writerQuota() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let personal = u.get('writerLimit', 0);
      let fromPlan = planWriterLimit(u);
      return personal > fromPlan ? personal : fromPlan;
    }

    function writerCanWrite() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        isUserActive(request.auth.uid);
    }

    function isNovelOwner(novelId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/novels/$(novelId)).data.get('ownerId', '') == request.auth.uid;
    }

    // A writer creates a novel: private draft, no price, counter +1 in the same batch, within quota.
    function writerNovelCreateOk(novelId) {
      let d = request.resource.data;
      let statsPath = /databases/$(database)/documents/writerStats/$(request.auth.uid);
      return writerCanWrite() &&
        d.ownerId == request.auth.uid &&
        d.keys().hasOnly([
          'title', 'titleEn', 'author', 'authorEn', 'genre', 'genreEn', 'genres', 'status',
          'description', 'descriptionEn', 'coverUrl', 'color', 'accent',
          'novelPrice', 'bookPrice', 'freeChapters', 'chaptersCount', 'chaptersSummary',
          'published', 'ownerId', 'reviewStatus', 'createdAt', 'createdAtMs', 'updatedAt'
        ]) &&
        d.get('published', false) == false &&
        d.get('reviewStatus', 'draft') in ['draft', 'pending'] &&
        d.get('novelPrice', 0) == 0 &&
        d.get('freeChapters', 0) == 0 &&
        d.get('bookPrice', null) == null &&
        d.get('chaptersCount', 0) == 0 &&
        d.title is string && d.title.size() >= 1 && d.title.size() <= 120 &&
        d.get('author', '').size() <= 80 &&
        d.get('description', '').size() <= 2000 &&
        existsAfter(statsPath) &&
        getAfter(statsPath).data.lastNovelId == novelId &&
        getAfter(statsPath).data.novelCount ==
          (exists(statsPath) ? get(statsPath).data.get('novelCount', 0) : 0) + 1 &&
        getAfter(statsPath).data.novelCount <= writerQuota();
    }

    // A writer edits their own novel: descriptive fields + chapter summary only; may send it for
    // review (draft/rejected -> pending) or take it back (pending -> draft). Never publish/price.
    function writerNovelUpdateOk() {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return writerCanWrite() &&
        resource.data.get('ownerId', '') == request.auth.uid &&
        changed.hasOnly([
          'title', 'titleEn', 'author', 'authorEn', 'genre', 'genreEn', 'genres', 'status',
          'description', 'descriptionEn', 'coverUrl', 'color', 'accent',
          'chaptersSummary', 'chaptersCount', 'reviewStatus', 'updatedAt'
        ]) &&
        (!changed.hasAny(['reviewStatus']) ||
          (resource.data.get('reviewStatus', 'draft') in ['draft', 'pending', 'rejected'] &&
           d.reviewStatus in ['draft', 'pending'])) &&
        d.title.size() >= 1 && d.title.size() <= 120 &&
        d.get('author', '').size() <= 80 &&
        d.get('description', '').size() <= 2000;
    }

    // A writer deletes their own novel: the counter must go -1 in the same batch.
    function writerNovelDeleteOk(novelId) {
      let statsPath = /databases/$(database)/documents/writerStats/$(request.auth.uid);
      return isSignedIn() &&
        resource.data.get('ownerId', '') == request.auth.uid &&
        existsAfter(statsPath) &&
        getAfter(statsPath).data.lastNovelId == novelId &&
        getAfter(statsPath).data.novelCount == get(statsPath).data.get('novelCount', 0) - 1;
    }

    // writerStats/{uid}: +1 only together with a NEW novel owned by uid (within quota),
    // -1 only together with the deletion of a novel owned by uid.
    function writerStatsWriteOk(uid) {
      let d = request.resource.data;
      let before = resource == null ? 0 : resource.data.get('novelCount', 0);
      let novelPath = /databases/$(database)/documents/novels/$(d.lastNovelId);
      return isOwner(uid) && writerCanWrite() &&
        d.keys().hasOnly(['novelCount', 'lastNovelId', 'updatedAt']) &&
        d.lastNovelId is string && d.novelCount is int &&
        (
          (d.novelCount == before + 1 && d.novelCount <= writerQuota() &&
           !exists(novelPath) && existsAfter(novelPath) &&
           getAfter(novelPath).data.get('ownerId', '') == uid)
          ||
          (d.novelCount == before - 1 && d.novelCount >= 0 &&
           exists(novelPath) && !existsAfter(novelPath) &&
           get(novelPath).data.get('ownerId', '') == uid)
        );
    }

    // Writer chapters: title/number/published only. They can never set isFree (free vs paid is the
    // admin's call, through novels.freeChapters / novels.isFreeNovel).
    function writerChapterCreateOk(novelId) {
      let d = request.resource.data;
      return isNovelOwner(novelId) && writerCanWrite() &&
        d.novelId == novelId &&
        d.keys().hasOnly(['novelId', 'number', 'title', 'titleEn', 'published', 'createdAt', 'updatedAt']) &&
        d.number is int && d.number >= 1 && d.number <= 500 &&
        d.title is string && d.title.size() <= 150 &&
        d.get('titleEn', '').size() <= 150 &&
        d.get('published', false) is bool;
    }

    function writerChapterUpdateOk(novelId) {
      let d = request.resource.data;
      return isNovelOwner(novelId) && writerCanWrite() &&
        d.novelId == novelId &&
        d.diff(resource.data).affectedKeys().hasOnly(['number', 'title', 'titleEn', 'published', 'updatedAt']) &&
        d.number is int && d.number >= 1 && d.number <= 500 &&
        d.title.size() <= 150 &&
        d.get('titleEn', '').size() <= 150;
    }

    function writerContentCreateOk() {
      let d = request.resource.data;
      return isNovelOwner(d.novelId) && writerCanWrite() &&
        d.keys().hasOnly(['novelId', 'body']) &&
        d.body is string && d.body.size() <= 200000;
    }

    function writerContentUpdateOk() {
      let d = request.resource.data;
      return isNovelOwner(resource.data.novelId) && writerCanWrite() &&
        d.novelId == resource.data.novelId &&
        d.diff(resource.data).affectedKeys().hasOnly(['body']) &&
        d.body is string && d.body.size() <= 200000;
    }

    // ---------------------------------------------------------------------------------------
    // Rating aggregates (novels/{id}) are maintained by the browser, so the rules re-check the
    // arithmetic: the novel's counters may only move by exactly the effect of the reader's own
    // review in the SAME batch/transaction (get = state before, getAfter = state after).
    // ---------------------------------------------------------------------------------------

    // Star counted for a review: its rating when published, otherwise 0 (not counted).
    function countedStar(review) {
      return review.status == 'published' ? review.rating : 0;
    }

    function starDelta(oldR, newR, star) {
      return (newR == star ? 1 : 0) - (oldR == star ? 1 : 0);
    }

    function distMatches(before, after, oldR, newR) {
      return after.keys().hasOnly(['1', '2', '3', '4', '5']) &&
        after.get('1', 0) == before.get('1', 0) + starDelta(oldR, newR, 1) &&
        after.get('2', 0) == before.get('2', 0) + starDelta(oldR, newR, 2) &&
        after.get('3', 0) == before.get('3', 0) + starDelta(oldR, newR, 3) &&
        after.get('4', 0) == before.get('4', 0) + starDelta(oldR, newR, 4) &&
        after.get('5', 0) == before.get('5', 0) + starDelta(oldR, newR, 5) &&
        after.get('1', 0) >= 0 && after.get('2', 0) >= 0 && after.get('3', 0) >= 0 &&
        after.get('4', 0) >= 0 && after.get('5', 0) >= 0;
    }

    // The stored average must agree with the distribution (small tolerance for 2-decimal rounding).
    function averageMatches(after) {
      let c = after.get('visitorRatingCount', 0);
      let d = after.get('ratingDistribution', {});
      let points = d.get('1', 0) + 2 * d.get('2', 0) + 3 * d.get('3', 0) + 4 * d.get('4', 0) + 5 * d.get('5', 0);
      let avg = after.get('visitorRatingAverage', 0);
      return after.get('rating', '') is string &&
        after.get('rating', '').size() <= 3 &&
        (c == 0 ? avg == 0 : math.abs(avg * c - points) <= 0.005 * c + 0.01);
    }

    // True when novels/{novelId} changes by exactly "oldR -> newR" between get() and getAfter().
    function novelAggregatesMatch(novelId, oldR, newR) {
      let novelPath = /databases/$(database)/documents/novels/$(novelId);
      let before = get(novelPath).data;
      let after = getAfter(novelPath).data;
      return after.get('visitorRatingCount', 0) ==
          before.get('visitorRatingCount', 0) + (newR > 0 ? 1 : 0) - (oldR > 0 ? 1 : 0) &&
        distMatches(before.get('ratingDistribution', {}), after.get('ratingDistribution', {}), oldR, newR) &&
        (oldR == newR
          ? (after.get('visitorRatingAverage', 0) == before.get('visitorRatingAverage', 0) &&
             after.get('rating', '') == before.get('rating', ''))
          : averageMatches(after));
    }

    // Keys a reader-written review may contain. NOTE: no email: reviews are publicly readable.
    function reviewKeysAllowed() {
      return request.resource.data.keys().hasOnly([
        'id', 'novelId', 'novelTitle', 'userId', 'userName',
        'rating', 'reviewText', 'status', 'moderationReason', 'moderatedAt',
        'moderatedBy', 'reportCount', 'createdAt', 'updatedAt'
      ]);
    }

    // Novel-side check: derive old/new star from the reader's own review document.
    function novelAggregatesMatchForOwnReview(novelId) {
      let revPath = /databases/$(database)/documents/reviews/$(novelId + '_' + request.auth.uid);
      let oldR = (exists(revPath) && get(revPath).data.status == 'published') ? get(revPath).data.rating : 0;
      let newR = (existsAfter(revPath) && getAfter(revPath).data.status == 'published') ? getAfter(revPath).data.rating : 0;
      return novelAggregatesMatch(novelId, oldR, newR);
    }

    // catalog/ratings write check (see match /catalog/ratings)
    function ratingSummaryWriteOk() {
      let d = request.resource.data;
      let before = resource == null ? {} : resource.data;
      let nid = d.get('lastNovelId', '');
      let key = 'r_' + nid;
      let novelPath = /databases/$(database)/documents/novels/$(nid);
      return nid is string && nid.size() > 0 &&
        d.diff(before).affectedKeys().hasOnly(['lastNovelId', 'updatedAt', key]) &&
        d[key].keys().hasOnly(['a', 'c']) &&
        d[key].c == get(novelPath).data.get('visitorRatingCount', 0) &&
        d[key].a == (get(novelPath).data.get('visitorRatingCount', 0) > 0
          ? get(novelPath).data.get('visitorRatingAverage', 0) : 0);
    }

    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins role collection: each user can only check their own document (no enumeration)
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    // Consolidated light public catalog (Home, Browse, Store read this single document)
    match /catalog/{catalogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Live rating summary shown on the cards: fields `r_<novelId>: { a: average, c: count }`.
    // A signed-in reader may change ONLY the entry of the novel named in `lastNovelId`, and it
    // must equal the aggregates stored on the (rule-protected) novel document, so nothing can be
    // forged. Combines (OR) with the admin rule of the generic catalog match above.
    match /catalog/ratings {
      allow create, update: if isSignedIn() && ratingSummaryWriteOk();
    }

    // Digital Book Downloads (PDF) - strictly protected for buyers of 'book' product
    match /bookFiles/{novelId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/entitlements/$(novelId)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/entitlements/$(novelId)).data.type == 'book'
      );
      allow write: if isAdmin();
    }

    // Novels metadata and rating summaries
    match /novels/{novelId} {
      // Public when published; a writer can always read their own (draft / pending) novels.
      allow read: if resource.data.published == true || isAdmin() ||
        (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if isAdmin() || writerNovelCreateOk(novelId);
      allow delete: if isAdmin() || writerNovelDeleteOk(novelId);
      // Readers may only move the rating counters by the effect of THEIR OWN review, written in
      // the same batch/transaction (reviews/{novelId}_{uid}); see novelAggregatesMatch above.
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'visitorRatingAverage', 'visitorRatingCount', 'ratingDistribution', 'rating', 'updatedAt'
        ]) &&
        novelAggregatesMatchForOwnReview(novelId)
      ) || writerNovelUpdateOk();

      // Chapter metadata subcollection
      match /chapters/{chapterId} {
        allow read: if resource.data.published == true || isAdmin() || isNovelOwner(novelId);
        allow create: if isAdmin() || writerChapterCreateOk(novelId);
        allow update: if isAdmin() || writerChapterUpdateOk(novelId);
        allow delete: if isAdmin() || isNovelOwner(novelId);
      }
    }

    // Chapter contents (protected text body)
    match /chapterContents/{chapterId} {
      allow read: if resource.data.get('isFree', false) == true ||
        isAdmin() ||
        (resource.data.novelId != null && isNovelOwner(resource.data.novelId)) ||
        (resource.data.novelId != null && hasNovelEntitlement(resource.data.novelId)) ||
        (resource.data.novelId != null && hasActiveSubscriptionFor(resource.data.novelId)) ||
        // Same rule as the UI (src/lib/freeChapters.ts): chapter flagged isFree OR its number is
        // within the novel's freeChapters setting OR the whole novel is flagged isFreeNovel.
        (
          resource.data.novelId != null &&
          exists(/databases/$(database)/documents/novels/$(resource.data.novelId)/chapters/$(chapterId)) &&
          (
            get(/databases/$(database)/documents/novels/$(resource.data.novelId)/chapters/$(chapterId)).data.get('isFree', false) == true ||
            get(/databases/$(database)/documents/novels/$(resource.data.novelId)/chapters/$(chapterId)).data.get('number', 0) <=
              get(/databases/$(database)/documents/novels/$(resource.data.novelId)).data.get('freeChapters', 0) ||
            get(/databases/$(database)/documents/novels/$(resource.data.novelId)).data.get('isFreeNovel', false) == true
          )
        );
      allow create: if isAdmin() || writerContentCreateOk();
      allow update: if isAdmin() || writerContentUpdateOk();
      allow delete: if isAdmin() || (resource.data.novelId != null && isNovelOwner(resource.data.novelId));
    }

    // Novel Reviews and Genuine Ratings
    // One review per reader per novel: the document id MUST be "{novelId}_{uid}".
    // Every reader write must come with the matching novel aggregate change (same batch).
    match /reviews/{reviewId} {
      // resource == null lets a reader "get" a review that does not exist yet
      // (needed by the transaction that creates it); it exposes nothing.
      allow read: if resource == null ||
        resource.data.status == 'published' ||
        isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn() &&
        request.auth.token.email_verified == true &&
        reviewId == request.resource.data.novelId + '_' + request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'published' &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        reviewKeysAllowed() &&
        request.resource.data.get('reviewText', '').size() <= 1000 &&
        request.resource.data.userName.size() <= 60 &&
        isUserActive(request.auth.uid) &&
        // only published novels can receive a NEW rating
        get(/databases/$(database)/documents/novels/$(request.resource.data.novelId)).data.get('published', false) == true &&
        novelAggregatesMatch(request.resource.data.novelId, 0, request.resource.data.rating);

      allow update: if isAdmin() || (
        isSignedIn() &&
        request.auth.token.email_verified == true &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.novelId == resource.data.novelId &&
        resource.data.status == 'published' &&
        request.resource.data.status == 'published' &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        reviewKeysAllowed() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status', 'moderationReason', 'moderatedAt', 'moderatedBy', 'reportCount'
        ]) &&
        request.resource.data.get('reviewText', '').size() <= 1000 &&
        isUserActive(request.auth.uid) &&
        novelAggregatesMatch(resource.data.novelId, countedStar(resource.data), request.resource.data.rating)
      );

      // A reader's own delete must remove that review's star from the novel in the same batch.
      allow delete: if isAdmin() || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        novelAggregatesMatch(resource.data.novelId, countedStar(resource.data), 0)
      );
    }

    // Moderation Reports submitted by users
    match /reports/{reportId} {
      allow create: if isSignedIn() &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.reason in ['spam', 'harassment', 'unlawful', 'other'] &&
        request.resource.data.get('details', '').size() <= 500 &&
        request.resource.data.keys().hasOnly([
          'id', 'reviewId', 'novelId', 'novelTitle', 'reportedUserId',
          'reportedUserName', 'reporterUid', 'reporterName', 'reason',
          'details', 'reviewExcerpt', 'reviewRating', 'status', 'createdAt',
          'resolvedAt', 'resolutionNote'
        ]);
      allow read, update, delete: if isAdmin();
    }

    // Administrative Actions Audit Log
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // User profiles & entitlements
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'createdAt', 'subscription',
          'status', 'restrictedReason', 'restrictedAt', 'reviewCount', 'ratingCount', 'orderCount'
        ]) &&
        request.resource.data.subscription == null &&
        request.resource.data.get('status', 'active') == 'active' &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 60 &&
        request.resource.data.email.size() <= 254;

      allow update: if (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'subscription', 'status', 'restrictedReason', 'restrictedAt', 'writerLimit'
        ]) &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 60
      ) || isAdmin();

      allow delete: if isAdmin();

      // Entitlements: read by owner/admin, ONLY writable by admin
      match /entitlements/{novelId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }

      // Reading progress & bookmarks
      match /library/{novelId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Writer counters (see writerStatsWriteOk). Owner reads their own; only +1/-1 with a novel create/delete.
    match /writerStats/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isAdmin() || writerStatsWriteOk(uid);
      allow delete: if isAdmin();
    }

    // Orders (Manual transfer without storage uploads)
    match /orders/{orderId} {
      allow create: if isSignedIn() &&
        request.auth.token.email_verified == true &&
        isUserActive(request.auth.uid) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.keys().hasOnly([
          'userId', 'userEmail', 'userName', 'items', 'total', 'discount',
          'couponCode', 'paymentMethod', 'senderPhone', 'transactionRef',
          'note', 'status', 'createdAt', 'receiptUrl'
        ]) &&
        request.resource.data.paymentMethod in ['vodafone_cash', 'instapay'] &&
        request.resource.data.senderPhone.matches('^01[0125][0-9]{8}$') &&
        request.resource.data.transactionRef.matches('^[A-Za-z0-9-]{6,30}$') &&
        request.resource.data.total >= 0 && request.resource.data.total <= 100000 &&
        request.resource.data.items.size() >= 1 && request.resource.data.items.size() <= 10 &&
        request.resource.data.get('note', '').size() <= 140;

      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Plans
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons
    match /coupons/{code} {
      allow get: if isSignedIn() || isAdmin();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Comments with strict input validation
    match /comments/{commentId} {
      allow read: if resource.data.hidden == false || isAdmin();
      allow create: if isSignedIn() &&
        request.auth.token.email_verified == true &&
        isUserActive(request.auth.uid) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.hidden == false &&
        request.resource.data.keys().hasOnly(['novelId', 'chapterId', 'userId', 'userName', 'text', 'hidden', 'createdAt']) &&
        request.resource.data.text.size() >= 1 &&
        request.resource.data.text.size() <= 500 &&
        request.resource.data.userName.size() <= 60;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Site settings
    match /settings/site {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
